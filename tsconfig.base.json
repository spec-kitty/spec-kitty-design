{
  "$schema": "./node_modules/typescript/lib/tsconfig-schema.json",
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@spec-kitty/tokens": ["packages/tokens/src/index.ts"],
      "@spec-kitty/styles": ["packages/styles/src/index.ts"],
      "@spec-kitty/elements": ["packages/elements/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
