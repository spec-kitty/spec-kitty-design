    {
      "created_at": "2026-09-02T20:36:11.287769Z",
      "decision_id": "01M1HXC6WQC90NK940WN2BXR9K",
      "final_answer": "Scope LightMode out of #69 exit criteria; #93 owns the fix",
      "input_key": "lightmode-exit-criterion",
      "mission_id": "01M1HVX4NCTMNE2VSE2MXH6Z0A",
      "mission_slug": "storybook-renderer-and-angular-retirement-01M1HVX4",
      "opened_by": "operator",
      "options": [
        "Scope LightMode out of #69 exit criteria; #93 owns the fix",
        "Fold the #93 selector fix into #69",
        "Accept dark rendering as the LightMode reference"
      ],
      "origin_flow": "plan",
      "other_answer": false,
      "question": "ADR-13 confirmation #3 and issue #69's exit criteria require LightMode variants to render correctly, but #93 shows every LightMode story already renders dark: :root[data-theme=light] cannot match the wrapper div the stories set the attribute on. Certify, fix, or scope out?",
      "rationale": "Operator decision, 2026-09-02. #69 is a builder swap; the #93 selector defect is a separate concern, and coupling them means one failure masks the other. No LightMode visual baseline exists (all 7 snapshots are -default/-with-ribbon), so nothing is frozen into the baseline set either way. #69 must NOT claim 'LightMode intact' at merge; ADR-13 confirmation #3 is unsatisfiable until #93 is fixed.",
      "resolved_at": "2026-09-02T20:36:27.055883Z",
      "resolved_by": "operator",
      "slot_key": null,
      "status": "resolved",
      "step_id": "lightmode-exit-criterion",
      "summary_json": null
    },
    {
      "created_at": "2026-09-02T21:22:16.751390Z",
      "decision_id": "01M1J00KHF3Z957ATR1QSZ744N",
      "final_answer": "Narrow NFR-003 to renderer-driven rewrites; permit unrelated story edits",
      "input_key": "story-file-edits",
      "mission_id": "01M1HVX4NCTMNE2VSE2MXH6Z0A",
      "mission_slug": "storybook-renderer-and-angular-retirement-01M1HVX4",
      "opened_by": "operator",
      "options": [
        "Narrow NFR-003 to renderer-driven rewrites; permit unrelated story edits",
        "Keep NFR-003 as an absolute bar on story edits",
        "Drop NFR-003 entirely"
      ],
      "origin_flow": "plan",
      "other_answer": false,
      "question": "NFR-003 forbids content edits to story files, which blocks fixing the missing sk-stub.css import. Operator reports a redesign is coming that will edit story files anyway. Should NFR-003 be lifted, narrowed, or kept?",
      "rationale": "Operator, 2026-09-02: a big redesign is coming and will edit story files regardless, so an absolute bar is not worth defending. NFR-003's evidentiary purpose is preserved by narrowing rather than dropping it: ADR-13's load-bearing claim is that no story needed rewriting TO RENDER under the web-components renderer, and that claim is still measured. Unrelated fixes (a missing CSS import, the type-import source) no longer breach it.",
      "resolved_at": "2026-09-02T21:22:30.601093Z",
      "resolved_by": "operator",
      "slot_key": null,
      "status": "resolved",
      "step_id": "story-file-edits",
      "summary_json": null
    }
