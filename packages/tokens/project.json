{
  "name": "tokens",
  "projectType": "library",
  "sourceRoot": "packages/tokens/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build-tokens-css.mjs && rm -rf packages/tokens/dist/fonts packages/tokens/dist/assets && mkdir -p packages/tokens/dist/fonts packages/tokens/dist/assets && cp -r packages/tokens/fonts/. packages/tokens/dist/fonts/ && cp -r packages/tokens/assets/. packages/tokens/dist/assets/"
      },
      "inputs": [
        "{projectRoot}/src/tokens.css",
        "{workspaceRoot}/scripts/build-tokens-css.mjs",
        "{projectRoot}/fonts/**/*",
        "{projectRoot}/assets/**/*"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "stylelint --allow-empty-input 'packages/tokens/src/**/*.css'" }
    },
    "catalogue": {
      "executor": "nx:run-commands",
      "options": { "command": "node scripts/generate-token-catalogue.js" },
      "dependsOn": []
    }
  },
  "tags": ["scope:tokens", "type:publishable"]
}
