{
  "name": "@spec-kitty/styles",
  "version": "1.0.0",
  "description": "Spec Kitty HTML primitives \u2014 CSS and markup only, no JavaScript",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./blog-card/*": "./dist/blog-card/*",
    "./button/*": "./dist/button/*",
    "./card/*": "./dist/card/*",
    "./check-bullet/*": "./dist/check-bullet/*",
    "./feature-card/*": "./dist/feature-card/*",
    "./form-field/*": "./dist/form-field/*",
    "./form-input/*": "./dist/form-input/*",
    "./form-textarea/*": "./dist/form-textarea/*",
    "./grid/*": "./dist/grid/*",
    "./nav-pill/*": "./dist/nav-pill/*",
    "./pill-tag/*": "./dist/pill-tag/*",
    "./ribbon-card/*": "./dist/ribbon-card/*",
    "./section-banner/*": "./dist/section-banner/*",
    "./site-footer/*": "./dist/site-footer/*",
    "./stub/*": "./dist/stub/*"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "peerDependencies": {
    "@spec-kitty/tokens": "^1.0.0"
  }
}
