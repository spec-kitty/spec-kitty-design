{
  "name": "@spec-kitty/elements",
  "version": "1.0.0",
  "description": "Spec Kitty custom-element base layer (ADR-8)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./elements.js": {
      "types": "./dist/elements.d.ts",
      "default": "./dist/elements.js"
    },
    "./vue": {
      "types": "./vue.d.ts"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./dist/*": "./dist/*"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist/",
    "custom-elements.json",
    "vue.d.ts"
  ],
  "peerDependencies": {
    "lit": "^3.3.3",
    "@spec-kitty/styles": "^1.0.0",
    "@spec-kitty/tokens": "^1.0.0"
  }
}
