{
  "name": "storybook",
  "projectType": "application",
  "sourceRoot": "apps/storybook/src",
  "targets": {
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev --config-dir apps/storybook/.storybook --port 6006",
        "forwardAllArgs": false
      },
      "dependsOn": [
        "^build"
      ]
    },
    "storybook:build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/storybook/storybook-static"
      ],
      "options": {
        "command": "storybook build --config-dir apps/storybook/.storybook --output-dir apps/storybook/storybook-static",
        "forwardAllArgs": false
      },
      "dependsOn": [
        "^build",
        "elements:build",
        "vite-consumer-fixture:build"
      ],
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/packages/*/src/**/*",
        "{workspaceRoot}/packages/*/assets/**/*",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/packages/*/package.json",
        "{workspaceRoot}/packages/elements/dist/**/*",
        "{workspaceRoot}/fixtures/vite-consumer/dist/**/*"
      ]
    }
  },
  "tags": [
    "scope:storybook",
    "type:app"
  ]
}
